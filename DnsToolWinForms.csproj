<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net48, т.к. приложение крутится прямо на Windows Server и не требует установки рантайма.
         Если у тебя Server 2022/2025 и хочется современнее - можно поменять на net8.0-windows,
         тогда UseWindowsForms остаётся, а PackageReference ниже не понадобится (нужен будет
         Microsoft.PowerShell.SDK вместо ReferenceAssemblies). -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>DnsToolWinForms</RootNamespace>
    <AssemblyName>DNS Server Tool</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>

    <!-- Метаданные сборки - видны в свойствах exe (правой кнопкой -> Свойства -> Подробности).
         Явно заданы, чтобы не зависеть от того, что Visual Studio подставит по умолчанию
         (логин пользователя Windows и т.п.) на машине, где идёт сборка. -->
    <Company>Kuzanov.e</Company>
    <Product>DNS Server Tool</Product>
    <Authors>Kuzanov.e</Authors>
    <Copyright>© Kuzanov.e, 2026</Copyright>
    <!-- Версия-счётчик: увеличивается на 1 после каждой правки (v1.9.<N>) - так по exe/окну
         сразу видно, какая сборка сейчас развёрнута, без сверки с датой файла. -->
    <AssemblyTitle>DNS Server Tool v1.9.2</AssemblyTitle>
    <Description>Инструмент управления DNS-сервером Windows: зоны, Zone Scopes, записи, подсети, политики.</Description>

    <!-- Иконка exe (проводник, панель задач, свойства файла). Обязательно положи файл icon.ico
         рядом с этим .csproj (именно .ico, не .png/.jpg) - без него сборка упадёт с ошибкой
         ("файл не найден" для Win32-ресурса). -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference assemblies для локального Windows PowerShell 5.1 (System.Management.Automation).
         Сам рантайм НЕ копируется в выходную папку - он и так уже встроен в Windows,
         этот пакет нужен только чтобы код скомпилировался. -->
    <PackageReference Include="Microsoft.PowerShell.5.1.ReferenceAssemblies" Version="1.0.0" />
  </ItemGroup>

  <!--
    ЕСЛИ NuGet не найдёт пакет Microsoft.PowerShell.5.1.ReferenceAssemblies (бывает, что он
    называется/версионируется иначе на разных машинах) - раскомментируй блок ниже и
    закомментируй PackageReference выше. Это прямая ссылка на системную сборку PowerShell 5.1,
    она есть на любом Windows со встроенным PowerShell:

  <ItemGroup>
    <Reference Include="System.Management.Automation">
      <HintPath>C:\Windows\assembly\GAC_MSIL\System.Management.Automation\1.0.0.0__31bf3856ad364e35\System.Management.Automation.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  -->

</Project>
